{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "pocket-studio-native",
  "version": "0.1.0",
  "identifier": "com.hendrikel80.pocketdrummer.native",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:5173",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "Pocket Studio",
        "width": 800,
        "height": 600,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "license": "GPL-3.0-only",
    "licenseFile": "../LICENSE",
    "copyright": "Copyright (C) 2026 Hendrik. Licensed under GPL-3.0-only.",
    "targets": ["nsis", "msi"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "resources": {
      "../public/samples": "samples",
      "../LICENSE": "LICENSE.txt",
      "../NOTICE.md": "NOTICE.md"
    },
    "android": {
      "debugApplicationIdSuffix": ".debug"
    }
  }
}
