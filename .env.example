# Welcher KI-Provider fuer Drum-Pattern-Generierung und Sound Like genutzt
# wird (siehe server/aiProvider.js). Optional, Default "anthropic".
# AI_PROVIDER=anthropic
# AI_PROVIDER=deepseek

ANTHROPIC_API_KEY=sk-ant-...
# Optional, Default siehe server/aiProvider.js
ANTHROPIC_MODEL=claude-sonnet-4-6

# Nur noetig, wenn AI_PROVIDER=deepseek. DeepSeeks API hat kein
# Web-Search-Tool - Sound Like faellt dann auf reines Modellwissen zurueck
# (siehe docs/sound-like.md).
# DEEPSEEK_API_KEY=sk-...
# Optional, Default siehe server/aiProvider.js
# DEEPSEEK_MODEL=deepseek-chat

API_PORT=3001

# Adresse eines gehosteten KI-Backends (z.B. https://api.example.com), die
# Vite beim Bauen ins Frontend einbaut. Leer lassen fuer den Dev-Modus
# (Vite leitet /api an den lokalen Server weiter). Ohne diesen Wert zeigt
# der installierte Desktop-Build "Generate a Beat" nur mit Library-
# Treffern und "Sound Like" als nicht verfuegbar an - einen eigenen
# Server bringt der Installer nicht mit. Das Backend muss dann CORS fuer
# den Tauri-Ursprung (http://tauri.localhost) erlauben.
# VITE_API_BASE_URL=

# Optionaler Shared-Secret-Schutz fuer /api/generate-pattern und
# /api/sound-like (siehe server/auth.js) - leer lassen, solange der Server
# nur auf localhost laeuft. Erst setzen, bevor er z.B. ueber Tailscale
# Funnel von aussen erreichbar wird. Beide Werte muessen identisch sein -
# VITE_API_ACCESS_TOKEN ist die Kopie, die Vite ins Frontend-Bundle baut,
# damit die Web-App den Header automatisch mitschickt.
# API_ACCESS_TOKEN=
# VITE_API_ACCESS_TOKEN=

# Rate-Limit fuer dieselben beiden Endpunkte (siehe server/rateLimit.js).
# Default ohne diese Variablen: 20 Anfragen pro 10 Minuten, gezaehlt pro
# IP-Adresse. WICHTIG bei einem Tunnel wie Tailscale Funnel: der reicht die
# echte Adresse externer Besucher nicht durch, alle von aussen kommenden
# Anfragen teilen sich dann denselben Zaehler - aus "20 pro Person" wird
# "20 fuer alle Freunde zusammen". Vor dem Freischalten ueber einen Tunnel
# bewusst hochsetzen, abgestimmt darauf wie viele Personen gleichzeitig
# mitnutzen sollen und wie viel Kosten-Spielraum das noch bedeutet.
# RATE_LIMIT_MAX=20
# RATE_LIMIT_WINDOW_MS=600000
